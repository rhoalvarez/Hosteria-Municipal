# ============================================================
# Configuración del backend – Restaurante Hostería "Portal de la Luna"
# ------------------------------------------------------------
# CÓMO USARLO:
#   1. Copiar este archivo y renombrar la copia a  .env
#   2. Completar los valores de la propia compu
# El .env NO se sube a GitHub (está en .gitignore) porque tiene
# contraseñas. Este .env.example SÍ se sube: es solo una guía.
# ============================================================

# Puerto donde escucha el backend (Node)
PORT=3000

# ---- Base de datos (MySQL / MariaDB de XAMPP) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# En XAMPP, root viene sin contraseña: dejar vacío.
# En la instalación de la hostería conviene ponerle una (propuesta).
DB_PASSWORD=
DB_NAME=hosteria

# ---- Tokens de sesión (JWT) ----
# Clave secreta para firmar los tokens. Cada compu usa la SUYA y no se comparte.
# Para generar una, en la terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pegar_aca_la_clave_generada
# Cuánto dura la sesión antes de pedir login de nuevo (8h ≈ un turno)
JWT_EXPIRES_IN=8h

# ---- CORS ----
# Direcciones desde donde se permite usar la API.
# Para desarrollo con Live Server (puerto 5500):
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500